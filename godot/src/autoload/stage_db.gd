## 生き物・物の表示名（ずかん・HUD 用）
const KIND_NAMES := {
	"mushiba": "むしばきん", "pylori": "ピロリきん", "akudama": "あくだまきん", "virus": "かぜウイルス",
	"boss_virus": "かぜウイルスだいおう", "cholesterol": "コレステロールの かたまり", "food": "たべものの かたまり",
	"rbc": "せっけっきゅう", "wbc": "はっけっきゅう", "zendama": "ぜんだまきん", "wallcell": "い（胃）の かべの さいぼう",
	"villus": "じゅうもう", "nutrient": "えいよう", "neuron": "しんけいさいぼう", "acid": "いえき",
	"valve": "べん", "wave": "ぜんどううんどう", "dust": "ほこり", "sneeze": "くしゃみ", "tooth": "は", "epiglottis": "のどの わかれみち",
	"heart_item": "げんきの つぶ",
}


func get_stage(id: String) -> Dictionary:
	for s in STAGES:
		if s["id"] == id:
			return s
	push_error("unknown stage: %s" % id)
	return {}


func stage_ids() -> Array[String]:
	var out: Array[String] = []
	for s in STAGES:
		out.append(s["id"])
	return out


func next_stage_id(id: String) -> String:
	var ids := stage_ids()
	var i := ids.find(id)
	if i < 0 or i + 1 >= ids.size():
		return ""
	return ids[i + 1]


func card(stage_id: String, key: String) -> Dictionary:
	var s := get_stage(stage_id)
	if s.is_empty():
		return {}
	var cards: Dictionary = s.get("cards", {})
	return cards.get(key, {})


func kind_name(kind: String) -> String:
	return KIND_NAMES.get(kind, kind)


## ずかん用：全ステージのカードを (stage_id, key, card) の配列で返す
func all_cards() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for s in STAGES:
		for key in s["cards"].keys():
			out.append({"stage": s["id"], "key": key, "card": s["cards"][key]})
		out.append({"stage": s["id"], "key": "summary", "card": s["summary"]})
	return out
