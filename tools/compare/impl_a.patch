+## あとの はなしの ページ：さいしょの よそうが あたりで lines_hit が あれば それ
+func after_lines(ep: Dictionary, i: int, first_guess: String) -> Array:
+	var a: Dictionary = ep["scenes"][i].get("after", {})
+	if a.has("lines_hit") and guess_is_hit(ep, first_guess):
+		return a["lines_hit"]
+	return a.get("lines", [])
