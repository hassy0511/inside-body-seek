+		var id: String = ep["id"]
+		var open := SaveData.is_unlocked(id)
+		var b := T.button(("カルテ %d　%s" % [ep["no"], ep["title"]]) if open else "？？？", 24, 560)
+		b.position = Vector2(40, y)
+		b.disabled = not open
+		if not open:
+			b.focus_mode = Control.FOCUS_NONE
+		b.pressed.connect(func(): _select(id, true))
+		b.focus_entered.connect(func(): _select(id, false))
+		add_child(b)
+		rows[id] = b
+		y += 110
+	_right = VBoxContainer.new()
+	_right.position = Vector2(680, 100)
+	_right.add_theme_constant_override("separation", 12)
