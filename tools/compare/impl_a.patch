+## さいしょの よそう（place）が「あたり」（hit: true の えらび）だったか
+func guess_is_hit(ep: Dictionary, first_guess: String) -> bool:
+	for c in ep.get("guess", {}).get("choices", []):
+		if c["place"] == first_guess:
+			return c.get("hit", false)
+	return false
