+func scene_stage(ep: Dictionary, i: int) -> Dictionary:
+	var sc: Dictionary = ep["scenes"][i]
+	var st: Dictionary = StageDB.get_stage(sc["place"]).duplicate(true)   # const は 読み取り専用。かならず 写しに 書く
+	for k in sc.keys():
+		if k != "place" and k != "after":
