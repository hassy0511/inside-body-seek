+		_right.add_child(T.label("ばめん %d まで おわっているよ" % int(r["cleared"]), 20))
+		restart_btn = T.button("さいしょから", 24, 320)
+		restart_btn.pressed.connect(func():
+			if not locked():
+				Game.start_episode(id))
+		_right.add_child(restart_btn)
+	else:
+		main_btn = T.button("しんさつ スタート！", 36, 320)
+		main_btn.pressed.connect(func():
+			if not locked():
+				Game.start_episode(id))
+		_right.add_child(main_btn)
+	if SaveData.is_cleared(id) and not SaveData.star_flags(id)[2]:
+		quiz_btn = T.button("クイズに もういちど ちょうせん", 24, 320)
