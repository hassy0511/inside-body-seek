new file mode 100644
index 0000000..0ff1587
--- /dev/null
+++ b/godot/src/ui/talk.gd
@@ -0,0 +1,73 @@
+extends "res://src/ui/flow_screen.gd"
+## はなしの 画面（そうだん・あとの はなし の 両方）。ボタンで ページを 進める。時間では 進まない。
+## いまは 仮の 画面：動きは 本物、見た目は 最小（レイアウトは docs/episodes.md 3.4 B）。
+
+signal finished
+signal cancelled
+
+## ふきだし（770×320）の 中の 文：32 px、幅 726、6 行まで
+const TEXT_SIZE := 32
+const TEXT_WIDTH := 726.0
+const TEXT_LINES := 6
+
+var lines: Array = []
+## mood（患者の 顔）、banner（上の 見出し）、last_label（さいごの ページの ボタン）、can_cancel（1 ページ目で もどれるか）、start_page
+var opts: Dictionary = {}
+var page := 0
+var _banner: Label
+var _text: Label
+var _next: Button
+
+
+## 文が ふきだしに 入るか（本物の フォントで はかる。テストが 全部の ページに 使う）
+static func text_fits(text: String) -> bool:
+	return lines_of(text, TEXT_SIZE, TEXT_WIDTH) <= TEXT_LINES
+
+
+func setup(l: Array, o := {}) -> void:
+	lines = l
+	opts = o
+
+
+func _ready() -> void:
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	_banner = T.label(opts.get("banner", ""), 48, Color(0.25, 0.5, 0.75))   # 赤に しない（まちがいの 色に 見せない）
+	_banner.position = Vector2(380, 60)
+	_banner.visible = _banner.text != ""
+	add_child(_banner)
+	_text = T.label("", TEXT_SIZE)
+	_text.position = Vector2(380, 160)
+	add_child(_text)
+	_next = T.button("つぎへ ▶", 30, 280)
+	_next.position = Vector2(860, 540)
+	_next.pressed.connect(_on_next)
+	add_child(_next)
+	page = clampi(int(opts.get("start_page", 0)), 0, lines.size() - 1)
+	_show()
+
+
+func _show() -> void:
+	_text.text = "%s：%s" % [EpisodeDB.speaker(lines[page]["who"])["name"], lines[page]["text"]]
+	_next.text = opts.get("last_label", "つぎへ ▶") if page == lines.size() - 1 else "つぎへ ▶"
+	set_focus(_next)
+	lock()
+
+
+func _on_next() -> void:
+	if locked():
+		return
+	if page + 1 < lines.size():
+		page += 1
+		_show()
+	else:
+		finished.emit()
+
+
+func _unhandled_input(event: InputEvent) -> void:
+	if event.is_action_pressed("ui_cancel"):
+		if page > 0:
+			page -= 1          # 1 ページ もどる（読みなおせる）
+			_show()
+		elif opts.get("can_cancel", false):
+			cancelled.emit()
+		get_viewport().set_input_as_handled()
