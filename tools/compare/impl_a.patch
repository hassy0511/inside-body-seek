+++ b/godot/src/ui/karte.gd
@@ -0,0 +1,171 @@
+extends "res://src/ui/flow_screen.gd"
+## カルテの 画面：段 0 かいけつ → 1 カルテの 紙 → 2 クイズ → 3 ほし。ボタンで 進む（時間では 進まない）。
+## いまは 仮の 画面：段の 進みかた・カルテの 紙・クイズは 本物、見た目は 最小（docs/episodes.md 3.4 D）。
+
+signal answered(correct: bool)
+signal finished(go_next: bool)
+
+const Sheet := preload("res://src/ui/karte_sheet.gd")
+const PANEL_HEIGHT := 640.0
+
+var ep: Dictionary
+## guess_hit（さいしょの よそうが あたり）、review（クリアずみの カルテを 読みかえす：紙から 始め、つぎの 話へは 行かない）
+var opts: Dictionary = {}
+var step := 0
+var correct := false
+var panel: PanelContainer
+var _vb: VBoxContainer
+
+
+func setup(e: Dictionary, o := {}) -> void:
+	ep = e
+	opts = o
+
+
+func _ready() -> void:
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	panel = PanelContainer.new()
+	panel.anchor_left = 0.5
+	panel.anchor_right = 0.5
+	panel.anchor_top = 0.5
+	panel.anchor_bottom = 0.5
+	panel.offset_left = -470
+	panel.offset_right = 470
+	panel.offset_top = -PANEL_HEIGHT / 2
+	panel.offset_bottom = PANEL_HEIGHT / 2
+	add_child(panel)
+	var margin := MarginContainer.new()
+	for side in ["left", "right", "top", "bottom"]:
+		margin.add_theme_constant_override("margin_" + side, 24)
+	panel.add_child(margin)
+	_vb = VBoxContainer.new()
+	_vb.add_theme_constant_override("separation", 10)
+	margin.add_child(_vb)
+	step = 1 if opts.get("review", false) else 0
+	_show()
+
+
+## はみ出して いないか（テストが 見る）
+func fits() -> bool:
+	return panel.get_combined_minimum_size().y <= PANEL_HEIGHT
+
+
+func _clear() -> void:
+	for c in _vb.get_children():
+		_vb.remove_child(c)
+		c.queue_free()
+
+
+func _wrap(text: String, size: int) -> Label:
+	var l := T.label(text, size)
+	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	l.custom_minimum_size.x = 880
+	l.add_theme_font_override("font", Game.font_regular)
+	return l
+
+
+## 段の 主ボタン（下の 右はし）。押しすぎ よけは lock()
+func _main(text: String, cb: Callable) -> Button:
+	var sp := Control.new()
+	sp.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	_vb.add_child(sp)
+	var b := T.button(text, 30, 320)
+	b.size_flags_horizontal = Control.SIZE_SHRINK_END
+	b.pressed.connect(func():
+		if not locked():
+			cb.call())
+	_vb.add_child(b)
+	set_focus(b)
+	lock()
+	return b
+
+
+func _go(s: int) -> void:
+	step = s
+	_show()
+
+
+func _show() -> void:
+	_clear()
+	var id: String = ep["id"]
+	match step:
+		0:
+			Sfx.play("clear")
+			_vb.add_child(T.label("かいけつ！", 48, Color(0.9, 0.35, 0.5)))
+			if ep["karte"].has("thanks"):
+				_vb.add_child(_wrap("%s：%s" % [EpisodeDB.speaker(ep["patient"])["name"], ep["karte"]["thanks"]], 28))
+			if ep["karte"].has("exit"):
+				_vb.add_child(_wrap(ep["karte"]["exit"], 24))
+			if opts.get("guess_hit", false):
+				_vb.add_child(T.label("★ きみの さいしょの よそう、あたっていたね！", 24, Color(0.75, 0.55, 0.2)))
+			_main("カルテを かく ▶", _go.bind(1))
+		1:
+			SaveData.mark_card(id, "karte")
+			_vb.add_child(T.label("カルテ %d　%s" % [ep["no"], ep["title"]], 26))
+			_vb.add_child(Sheet.build(ep))
+			_main("クイズに ちょうせん！", _go.bind(2))
+		2:
+			_show_quiz()
+		3:
+			_show_stars()
+
+
+## クイズ：えらびは まぜて ならべる。最初の フォーカスは 一番 上
+func _show_quiz() -> void:
+	var q: Dictionary = ep["quiz"]
+	_vb.add_child(T.label("クイズ", 20, Color(0.3, 0.5, 0.75)))
+	_vb.add_child(_wrap(q["q"], 34))
+	var order := [0, 1, 2]
+	order.shuffle()
+	var first: Button = null
+	for n in 3:
+		var i: int = order[n]
+		var b := T.button(["Ａ", "Ｂ", "Ｃ"][n] + "　" + q["choices"][i], 28)
+		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
+		T.colored_button(b, T.SKY, Color(0.3, 0.55, 0.8))
+		b.pressed.connect(func():
+			if locked():
+				return
+			correct = i == int(q["answer"])
+			_go(3))
+		_vb.add_child(b)
+		if first == null:
+			first = b
+	set_focus(first)
+	lock()
+
+
+func _show_stars() -> void:
+	var id: String = ep["id"]
+	answered.emit(correct)                 # Game が 記録する（ほしの 印は 回を またいで たまる）
+	Sfx.play("quiz_ok" if correct else "wrong")
+	_vb.add_child(T.label("せいかい！" if correct else "おしい！", 48, Color(0.9, 0.35, 0.5) if correct else Color(0.4, 0.5, 0.7)))
+	_vb.add_child(_wrap(ep["quiz"]["explain"], 24))
+	var f := SaveData.star_flags(id)
+	var miss: Array[String] = []
+	var sf := SaveData.scene_flags(id)
+	for i in sf.size():
+		if not sf[i]:
+			miss.append(str(i + 1))
+	_vb.add_child(T.label("ほし %d こ！" % SaveData.stars(id), 28))
+	_vb.add_child(T.label("● カルテ かんせい！" if f[0] else "○ カルテ かんせい（また こんど！）", 22))
+	if miss.is_empty():
+		_vb.add_child(T.label("● ハートを へらさずに", 22))
+	else:
+		# どの 場面が まだ かを 言う（つぎの 回で その 場面だけ がんばれば よい）
+		_vb.add_child(T.label("○ ハートを へらさずに（ばめん %s が まだ）" % "・".join(PackedStringArray(miss)), 22))
+	_vb.add_child(T.label("● クイズに せいかい" if f[2] else "○ クイズに せいかい（また こんど！）", 22))
+	var next := EpisodeDB.next_id(id)
+	if opts.get("review", false) or (next == "" and not EpisodeDB.SEASON_COMPLETE):
+		_main("カルテえらびへ", finished.emit.bind(false))
+	else:
+		var main := _main("つぎの カルテへ ▶" if next != "" else "エンディングへ ▶", finished.emit.bind(true))
+		# ここで やめる 道も いつも 出す（フォーカスは 主ボタンの まま）
+		var back := T.button("カルテえらびへ", 24, 240)
+		back.size_flags_horizontal = Control.SIZE_SHRINK_END
+		back.pressed.connect(func():
+			if not locked():
+				finished.emit(false))
+		_vb.add_child(back)
+		main.focus_neighbor_bottom = back.get_path()
+		back.focus_neighbor_top = main.get_path()
